{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Körperfluss platform.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "lecturer"] },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "AssessmentResult": {
      "title": "AssessmentResult",
      "description": "A result of a student's assessment or quiz.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["quiz", "case-training", "anamnese"] },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "feedback": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "score", "total", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "assessments/{assessmentId}": {
      "schema": "AssessmentResult",
      "description": "Results of assessments."
    }
  }
}
